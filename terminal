removes all packages installed after a certain date
grep "yyyy-mm-dd.*.install " /var/log/dpkg.log | awk '{ print $4 }' | cut -d: -f1 | xargs sudo apt-get --yes purge

see what you installed recently 
grep "install" /var/log/dpkg.log

"unable to mount flashdrive, operation already pending" resolution:
gsettings set org.gnome.desktop.media-handling automount false


pandocs (making md to pdf)
$ sudo apt install pandoc
$ pandoc input.md -o output.pdf -V geometry:top=.5in -V geometry:bottom=.5in -V geometry:left=.5in -V geometry:right=.5in
$ sudo apt-get install texlive-latex-base
$ sudo apt install texlive-latex-base texlive-fonts-recommended texlive-latex-extra
